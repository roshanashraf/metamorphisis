<div class="theme-switch" role="group" aria-label="Color theme">
  <button
    class="theme-switch__option"
    type="button"
    data-theme-choice="light"
    aria-pressed="true"
    aria-label="Light theme"
  >
    <svg class="theme-switch__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="4.25" stroke="currentColor" stroke-width="1.6"></circle>
      <path
        d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.55 1.55M17.85 17.85l1.55 1.55M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.55-1.55M17.85 6.15l1.55-1.55"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"></path>
    </svg>
  </button>
  <button
    class="theme-switch__option"
    type="button"
    data-theme-choice="dark"
    aria-pressed="false"
    aria-label="Dark theme"
  >
    <svg class="theme-switch__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M14.8 3.4a7.6 7.6 0 1 0 6.8 11.8 6.2 6.2 0 0 1-6.8-11.8Z"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linejoin="round"></path>
    </svg>
  </button>
</div>

<script>
  const storageKey = 'theme';

  function savedTheme(): 'light' | 'dark' | null {
    try {
      const saved = localStorage.getItem(storageKey);
      if (saved === 'light' || saved === 'dark') return saved;
    } catch {
      /* ignore */
    }
    return null;
  }

  function resolvedTheme(): 'light' | 'dark' {
    return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
  }

  function syncThemeSwitch() {
    const theme = resolvedTheme();
    for (const node of document.querySelectorAll('[data-theme-choice]')) {
      if (!(node instanceof HTMLButtonElement)) continue;
      node.setAttribute('aria-pressed', String(node.dataset.themeChoice === theme));
    }

    const meta = document.querySelector('meta[name="theme-color"]');
    if (!meta) return;
    const quiet = document.body.classList.contains('page-home');
    const styles = getComputedStyle(document.documentElement);
    const color = styles.getPropertyValue(quiet ? '--color-home' : '--color-paper').trim();
    if (color) meta.setAttribute('content', color);
  }

  function setTheme(theme: 'light' | 'dark', persist: boolean) {
    document.documentElement.dataset.theme = theme;
    if (persist) {
      try {
        localStorage.setItem(storageKey, theme);
      } catch {
        /* ignore */
      }
    }
    syncThemeSwitch();
    window.dispatchEvent(new CustomEvent('theme-change', { detail: theme }));
  }

  function onClick(event: Event) {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const button = target.closest('[data-theme-choice]');
    if (!(button instanceof HTMLButtonElement)) return;
    const choice = button.dataset.themeChoice;
    if (choice !== 'light' && choice !== 'dark') return;
    setTheme(choice, true);
  }

  let themeListenerInstalled = false;

  function boot() {
    if (!themeListenerInstalled) {
      document.addEventListener('click', onClick);
      themeListenerInstalled = true;
    }
    document.documentElement.dataset.theme = savedTheme() ?? 'light';
    syncThemeSwitch();
  }

  document.addEventListener('astro:page-load', boot);
  boot();
</script>

<style>
  .theme-switch {
    display: inline-flex;
    align-items: center;
    padding: 2px;
    border: 1px solid color-mix(in srgb, currentColor 22%, transparent);
    border-radius: 999px;
    color: var(--color-ink);
  }

  .theme-switch__option {
    display: grid;
    place-items: center;
    width: 36px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    opacity: 0.55;
    cursor: pointer;
  }

  .theme-switch__icon {
    display: block;
  }

  .theme-switch__option:hover,
  html:not([data-theme='dark']) .theme-switch__option[data-theme-choice='light'],
  html[data-theme='dark'] .theme-switch__option[data-theme-choice='dark'] {
    opacity: 1;
  }

  html:not([data-theme='dark']) .theme-switch__option[data-theme-choice='light'],
  html[data-theme='dark'] .theme-switch__option[data-theme-choice='dark'] {
    background: var(--color-ink);
    color: var(--color-on-ink);
  }

  .theme-switch__option:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }
</style>
