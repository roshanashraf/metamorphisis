---
import { Image } from 'astro:assets';
import CaseCompanion from '../../case/CaseCompanion.astro';
import CaseIndex from '../../case/CaseIndex.astro';
import CaseStudyBar from '../../case/CaseStudyBar.astro';
import ScreenRail from '../../case/ScreenRail.astro';
import CaseNext from '../../case/CaseNext.astro';
import PickupNumbersScrolly from './PickupNumbersScrolly.astro';
import FlightTouchpointFlow from './FlightTouchpointFlow.astro';
import FlightInfoCollectionFlow from './FlightInfoCollectionFlow.astro';
import flow01 from '../../../assets/projects/airport-pickups/flow-01-cab-search-empty.png';
import flow02 from '../../../assets/projects/airport-pickups/flow-02-pickup-suggestions.png';
import flow03 from '../../../assets/projects/airport-pickups/flow-03-terminal-search.png';
import flow04 from '../../../assets/projects/airport-pickups/flow-04-dropoff-suggestions.png';
import flow05 from '../../../assets/projects/airport-pickups/flow-05-dropoff-search.png';
import flow06 from '../../../assets/projects/airport-pickups/flow-06-route-selected.png';
import flow07 from '../../../assets/projects/airport-pickups/flow-07-trip-start-picker.png';
import flow08 from '../../../assets/projects/airport-pickups/flow-08-ready-to-search.png';
import flow09 from '../../../assets/projects/airport-pickups/flow-09-cabs-loading.png';
import flow10 from '../../../assets/projects/airport-pickups/flow-10-cabs-flat-list.png';
import flow11 from '../../../assets/projects/airport-pickups/flow-11-cabs-by-category.png';
import flow12 from '../../../assets/projects/airport-pickups/flow-12-review-pay.png';
import bookingListingUsp from '../../../assets/projects/airport-pickups/booking-listing-flight-tracked-usp.png';
import bookingFlightBottomSheet from '../../../assets/projects/airport-pickups/booking-flight-tracked-bottomsheet.jpg';
import review01 from '../../../assets/projects/airport-pickups/review-01-connect-empty.png';
import review02 from '../../../assets/projects/airport-pickups/review-02-enter-number.png';
import review03 from '../../../assets/projects/airport-pickups/review-03-adding.png';
import review04 from '../../../assets/projects/airport-pickups/review-04-synced.png';
import review05 from '../../../assets/projects/airport-pickups/review-05-flight-card.png';
import review06 from '../../../assets/projects/airport-pickups/review-06-departure-airport.png';
import review07 from '../../../assets/projects/airport-pickups/review-07-choose-flight.png';
import review08 from '../../../assets/projects/airport-pickups/review-08-choose-adding.png';
import review09 from '../../../assets/projects/airport-pickups/review-09-prefill-add.png';
import webReview from '../../../assets/projects/airport-pickups/web-review-flight-tracked.jpg';

interface NextProject {
  href: string;
  title: string;
}

interface Props {
  year: number;
  role: string;
  next: NextProject | null;
}

const { year, role, next } = Astro.props;

const guideDefault = 'The cab had a time. The flight did not.';

const sections = [
  { id: 'pickups', label: 'Better airport pickups' },
  { id: 'flow', label: 'How booking worked before' },
  { id: 'numbers', label: 'What was happening?' },
  { id: 'open', label: 'Why are people cancelling?' },
  { id: 'move', label: 'We already track the flight.' },
  { id: 'touchpoint', label: 'Where to ask for the flight' },
  { id: 'on-booking', label: 'Highlight Flight Tracked Cab on the listing' },
  { id: 'flight-info', label: 'Flight info collection' },
  { id: 'post-booking', label: 'Post booking experience' },
  { id: 'web', label: 'Same ask on web before you pay' },
  { id: 'close', label: 'The booking follows the flight' },
];

const flowScreens = [
  {
    src: flow01,
    alt: 'Cab search on Airport Transfers with empty from and to fields.',
    caption: 'Airport transfers—search with no flight on the form.',
  },
  {
    src: flow02,
    alt: 'Location search with favorites and suggested places for the pickup.',
    caption: 'Pick the airport—favorites and search.',
  },
  {
    src: flow03,
    alt: 'Search results listing airport terminals while typing.',
    caption: 'Terminal search results.',
  },
  {
    src: flow04,
    alt: 'Drop-off search with terminal already set as the from address.',
    caption: 'Pick drop-off—with terminal fixed as from.',
  },
  {
    src: flow05,
    alt: 'Drop-off search results for Prestige addresses.',
    caption: 'Drop-off results.',
  },
  {
    src: flow06,
    alt: 'Cab search with route filled and a trip start date and time.',
    caption: 'Route set—trip start is already on the search.',
  },
  {
    src: flow07,
    alt: 'Bottom sheet to choose trip start date and time on a scroll picker.',
    caption: 'Pickup time—you choose when the cab should arrive.',
  },
  {
    src: flow08,
    alt: 'Cab search ready to submit with from, to, and trip start filled.',
    caption: 'Search—time locked in before results.',
  },
  {
    src: flow09,
    alt: 'Loading screen while cab partners are fetched.',
    caption: 'Loading cabs.',
  },
  {
    src: flow10,
    alt: 'Flat list of available cabs with prices.',
    caption: 'Cab list—flat view.',
  },
  {
    src: flow11,
    alt: 'Cab results grouped by hatchback, sedan, and SUV.',
    caption: 'Cab list—by category.',
  },
  {
    src: flow12,
    alt: 'Review ride screen with trip time, inclusions, and payment options.',
    caption: 'Review and pay—still no flight on the booking.',
  },
];

const bookingScreens = [
  {
    src: bookingListingUsp,
    alt: 'Cab list with a Flight Tracked Cab banner above the vehicles.',
    caption: 'Listing—Flight Tracked Cab as the USP above the cabs.',
  },
  {
    src: bookingFlightBottomSheet,
    alt: 'Bottom sheet explaining flight tracked cabs and adding flight details on the next page.',
    caption: 'Info—add flight on review; we track and meet you when you land.',
  },
];

const postBookingScreens = [
  {
    mark: '9',
    alt: 'On time. The pickup holds.',
    caption: 'On time—the pickup holds.',
  },
  {
    mark: '9.1',
    alt: 'Delayed. Landing moves with the flight.',
    caption: 'Delayed—landing moves with the flight.',
  },
  {
    mark: '9.2',
    alt: 'After the ride, the trip still says the flight was tracked.',
    caption: 'After the ride—it still says the flight was tracked.',
  },
];

const flightInfoPrimary = [
  {
    src: review01,
    alt: 'Review with Connect your flight empty and a field for flight number or PNR.',
    caption: 'Connect your flight—empty field.',
  },
  {
    src: review02,
    alt: 'Entering flight number 6E 373 with confirm.',
    caption: 'Type and confirm.',
  },
  {
    src: review03,
    alt: 'Loading state while adding the flight.',
    caption: 'Adding your flight…',
  },
  {
    src: review04,
    alt: 'Green synced successfully message.',
    caption: 'Synced successfully.',
  },
  {
    src: review05,
    alt: 'Flight card showing IndiGo 6E 373 Jaipur to Bengaluru.',
    caption: 'Flight on the booking before pay.',
  },
];

const flightInfoAlternate = [
  {
    src: review06,
    alt: 'Bottom sheet to pick departure airport.',
    caption: 'Departure airport.',
  },
  {
    src: review07,
    alt: 'List of flights to choose from.',
    caption: 'Choose your flight.',
  },
  {
    src: review08,
    alt: 'Loading while adding the chosen flight.',
    caption: 'Adding your flight…',
  },
];

const flightInfoPrefill = {
  src: review09,
  alt: 'Review with found MakeMyTrip flight and confirm before Add flight.',
  caption: 'Confirm your flight—then Add flight.',
};

const situations = [
  { index: '01', title: 'Flight late before takeoff', end: 'Cancel or change the booking' },
  { index: '02', title: 'Land early', end: 'Wait or cancel' },
  { index: '03', title: 'Late in the air', end: 'Driver may cancel' },
  { index: '04', title: 'Booked for “now”', end: 'Keep waiting' },
];

---

<article class="case">
  <CaseStudyBar />
  <CaseIndex sections={sections} />
  <CaseCompanion defaultLine={guideDefault} />

  <header class="case-hero" id="pickups" data-guide={guideDefault} data-guide-mode="hero">
    <h1 class="case-title">Better airport pickups</h1>
    <p class="case-lede">The cab had a time. The flight did not.</p>
    <p class="case-meta">Airport cabs · MakeMyTrip · {role} · {year}</p>
  </header>

  <section
    class="story-beat pickup-block"
    id="flow"
    aria-labelledby="flow-title"
    data-guide="Before, review never moved cab time with the flight."
    data-guide-mode="toolkit"
  >
    <h2 class="case-section" id="flow-title">Current Experience</h2>
    <ScreenRail screens={flowScreens} eager />
  </section>

  <section
    class="story-beat pickup-block pickup-numbers-block"
    id="numbers"
    aria-labelledby="numbers-title"
    data-guide="What was happening?"
    data-guide-mode="work"
  >
    <PickupNumbersScrolly />
   </section>

  <section
    class="story-beat pickup-block"
    id="open"
    aria-labelledby="open-title"
    data-guide="Why are people cancelling? Four splits—and what people do."
    data-guide-mode="toolkit"
  >
    <h2 class="case-section" id="open-title">Why are people cancelling?</h2>
    <div class="pickup-prose">
      <p>You book a cab for a set time. The flight lands on its own schedule.</p>
      <p>When those two don’t match, people cancel, wait, or the driver cancels.</p>
    </div>
    <h3 class="pickup-situations__title" id="situations-title">Four times that goes wrong</h3>
    <ol class="pickup-situations" aria-labelledby="situations-title">
      {
        situations.map((item) => (
          <li>
            <span class="pickup-situations__index">{item.index}</span>
            <div>
              <p class="case-subhead">{item.title}</p>
              <p class="case-body">{item.end}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section
    class="story-beat pickup-move"
    id="move"
    aria-labelledby="move-title"
    data-guide="We already tracked flights—I tied the cab to landing."
    data-guide-mode="work"
  >
    <div class="pickup-move__banner">
      <h2 class="pickup-move__title" id="move-title">We already track the flight.</h2>
      <p class="pickup-move__lede">So the cab can wait on landing.</p>
    </div>
 
  </section>

  <section
    class="story-beat pickup-block"
    id="touchpoint"
    aria-labelledby="touchpoint-title"
    data-guide="Landing would burden every trip—review fits pickup-only."
    data-guide-mode="method"
  >
    <h2 class="case-section" id="touchpoint-title">Where to ask for the flight</h2>
    <p class="case-body">
      Search has to work for airport pickup and airport drop. Only pickup needs a flight. A field on landing
      would burden every drop and fight the pickup-time control. We asked on review, once they chose a cab that
      waits on landing.
    </p>
    <FlightTouchpointFlow />
  </section>

  <section
    class="story-beat pickup-block"
    id="on-booking"
    aria-labelledby="on-booking-title"
    data-guide="USP on the list—not one row. Info sets up review."
    data-guide-mode="method"
  >
    <h2 class="case-section" id="on-booking-title">
      Highlight Flight Tracked Cab as a USP on the listing page
    </h2>
    <p class="case-body">
      On airport pickup, the list leads with Flight Tracked Cab—cab ready whenever you land—not a label
      hidden on one vehicle. Tap info for a short sheet: add your flight on review, and we track it so
      pickup follows landing.
    </p>
    <ScreenRail screens={bookingScreens} eager />
  </section>

  <section
    class="story-beat pickup-block"
    id="flight-info"
    aria-labelledby="flight-info-title"
    data-guide="Type, find, or add the flight we already know."
    data-guide-mode="work"
  >
    <h2 class="case-section" id="flight-info-title">Flight info collection</h2>
    <p class="case-body">
      On review, connect your flight: enter a number or PNR, or follow <strong>Find your flight</strong> when
      you do not have it handy. When you already have a MakeMyTrip flight the same day to this airport, we
      surface it with <strong>Add flight</strong>—no typing.
    </p>
    <FlightInfoCollectionFlow
      primary={flightInfoPrimary}
      alternate={flightInfoAlternate}
      prefill={flightInfoPrefill}
    />
  </section>

  <section
    class="story-beat pickup-block"
    id="post-booking"
    aria-labelledby="post-booking-title"
    data-guide="After pay, pickup follows the flight—not the clock."
    data-guide-mode="toolkit"
  >
    <h2 class="case-section" id="post-booking-title">Post booking experience</h2>
    <p class="case-body">
      After you pay, timing follows the flight—not the time you picked at checkout. On time, pickup
      holds. Delayed, landing moves with it. The trip keeps showing the flight was tracked.
    </p>
    <ScreenRail screens={postBookingScreens} />
  </section>

  <section
    class="story-beat pickup-block"
    id="web"
    aria-labelledby="web-title"
    data-guide="Same flight ask on web before pay."
    data-guide-mode="faq"
  >
    <h2 class="case-section" id="web-title">Same ask on web before you pay</h2>
    <p class="case-body">
      On a wide screen you can type the flight or confirm one we already found.
    </p>
    <figure class="pickup-wide">
      <Image
        class="pickup-wide__img"
        src={webReview}
        alt="Desktop review with Flight tracked cabs banner and flight number field before pay."
        widths={[640, 960, 1024]}
        sizes="(max-width: 768px) 100vw, min(1024px, 92vw)"
        loading="lazy"
      />
      <figcaption>Web review—same flight ask before you pay.</figcaption>
    </figure>
  </section>

  <section
    class="story-beat pickup-block"
    id="close"
    aria-labelledby="close-title"
    data-guide="The booking follows the flight."
    data-guide-mode="contact"
  >
    <h2 class="case-section" id="close-title">The booking follows the flight.</h2>
  </section>

  <CaseNext next={next} />
</article>

<style>
  .case-hero {
    display: grid;
    gap: var(--space-4);
  }

  .case-lede {
    margin-top: var(--space-2);
  }

  .pickup-block {
    margin-top: var(--case-gap);
    display: grid;
    gap: var(--space-4);
  }

  .pickup-numbers-block {
    justify-items: center;
  }

  .pickup-numbers-block__note {
    width: min(100%, 52rem);
    max-width: 36ch;
    text-align: center;
  }

  .pickup-block > .case-body,
  .pickup-prose {
    max-width: 42ch;
  }

  .pickup-prose {
    display: grid;
    gap: var(--space-4);
  }

  .pickup-prose p {
    font-size: var(--case-body);
    line-height: 1.65;
    color: var(--color-home-muted);
    text-wrap: pretty;
  }

  .pickup-situations__title {
    margin: var(--space-5) 0 0;
    font-family: var(--font-home-display);
    font-size: var(--case-subhead);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--color-home-ink);
    text-wrap: balance;
  }

  .pickup-situations {
    display: grid;
    margin-top: var(--space-3);
  }

  .pickup-situations li {
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    gap: var(--space-3);
    align-items: baseline;
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-home-rule);
  }

  .pickup-situations li:last-child {
    border-bottom: 1px solid var(--color-home-rule);
  }

  .pickup-situations__index {
    font-family: var(--font-home-display);
    font-size: var(--case-subhead);
    line-height: 1.1;
    color: var(--color-home-muted);
  }

  .pickup-situations li .case-body {
    margin-top: 0.35rem;
  }

  .pickup-move {
    margin-top: var(--case-gap);
    display: grid;
    gap: var(--space-4);
  }

  .pickup-move__banner {
    margin-inline: -48px;
    padding: clamp(2rem, 5.5vw, 3.25rem) clamp(1.75rem, 4.5vw, 3rem);
    border-radius: clamp(28px, 5vw, 48px);
    background: var(--color-airport-mint);
    display: grid;
    gap: 0.15em;
    max-width: none;
  }

  .pickup-move__title,
  .pickup-move__lede {
    margin: 0;
    font-family: var(--font-home-display);
    font-size: clamp(1.85rem, 4.6vw, 3.35rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.12;
    color: #0a0a0a;
    text-wrap: balance;
  }

  .pickup-move__lede {
    font-style: italic;
  }

  .pickup-move__body {
    max-width: 36ch;
    padding-inline: 2px;
  }

  .pickup-wide {
    display: grid;
    gap: 10px;
    margin-top: var(--space-3);
  }

  .pickup-wide__img {
    width: 100%;
    height: auto;
    border-radius: 16px;
    background: var(--color-home);
    filter: var(--shadow-preview);
  }

  .pickup-wide figcaption {
    font-size: var(--case-body);
    line-height: 1.5;
    color: var(--color-home-muted);
    max-width: 28ch;
  }

  @media (min-width: 768px) {
    .pickup-move__banner {
      margin-inline: -96px;
      padding-inline: clamp(3rem, 7vw, 5rem);
    }
  }
</style>
