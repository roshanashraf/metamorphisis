---
const dotCount = 100;
const dots = Array.from({ length: dotCount }, (_, i) => i);
---

<p class="pickup-numbers-scrolly__sr-only">
  Of all airport cab bookings, 80% were trips that happened and 20% did not. Of the 20% that did
  not happen, 85% were traveller cancellations and 15% were operator said no.
</p>

<div class="pickup-numbers pickup-numbers-scrolly__static">
  <div>
    <p class="case-metric__group-label">All airport cab bookings</p>
    <ul class="pickup-metrics" role="list">
      <li class="case-metric">
        <p class="case-metric__value">80%</p>
        <p class="case-metric__label">Trip happened</p>
      </li>
      <li class="case-metric">
        <p class="case-metric__value">20%</p>
        <p class="case-metric__label">Trip did not happen</p>
      </li>
    </ul>
  </div>
  <div>
    <p class="case-metric__group-label">Of the 20% that did not happen</p>
    <ul class="pickup-metrics" role="list">
      <li class="case-metric">
        <p class="case-metric__value">85%</p>
        <p class="case-metric__label">Traveller cancelled</p>
      </li>
      <li class="case-metric">
        <p class="case-metric__value">15%</p>
        <p class="case-metric__label">Operator said no</p>
      </li>
    </ul>
  </div>
</div>

<div class="pickup-numbers-scrolly" data-pickup-numbers-scrolly data-active-step="1">
  <div class="pickup-numbers-scrolly__layout">
    <div class="pickup-numbers-scrolly__steps" aria-hidden="true">
      <div class="pickup-numbers-scrolly__step" data-step="1"></div>
      <div class="pickup-numbers-scrolly__step" data-step="2"></div>
      <div class="pickup-numbers-scrolly__step" data-step="3"></div>
      <div class="pickup-numbers-scrolly__step" data-step="4"></div>
    </div>

    <div class="pickup-numbers-scrolly__stage">
      <div class="pickup-numbers-scrolly__copy">
        <p class="pickup-numbers-scrolly__line" data-line="1">Of all airport cab bookings</p>
        <p class="pickup-numbers-scrolly__line" data-line="2">
          <span class="pickup-numbers-scrolly__emph">80%</span> — trip happened
        </p>
        <p class="pickup-numbers-scrolly__line" data-line="3">
          Of the <span class="pickup-numbers-scrolly__emph">20%</span> that did not happen
        </p>
        <p class="pickup-numbers-scrolly__line" data-line="4">
          <span class="pickup-numbers-scrolly__emph">85%</span> traveller cancelled
        </p>
        <p class="pickup-numbers-scrolly__line pickup-numbers-scrolly__line--sub" data-line="5">
          <span class="pickup-numbers-scrolly__emph">15%</span> operator said no
        </p>
      </div>

      <div class="pickup-numbers-scrolly__grid-wrap" aria-hidden="true">
        <div class="pickup-numbers-scrolly__band"></div>
        <div class="pickup-numbers-scrolly__grid">
          {dots.map((i) => (
            <span class="pickup-numbers-scrolly__dot" data-i={i} />
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { mountPickupNumbersScrolly } from './pickup-numbers-scrolly.client.ts';

  let unmount = () => {};

  function boot() {
    unmount();
    unmount = mountPickupNumbersScrolly();
  }

  document.addEventListener('astro:page-load', boot);
  boot();
</script>

<style>
  .pickup-numbers-scrolly__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .pickup-numbers-scrolly__static {
    display: grid;
    gap: var(--space-6);
  }

  .pickup-numbers-scrolly {
    display: none;
  }

  .pickup-metrics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 960px) {
    .pickup-numbers-scrolly__static {
      display: none;
    }

    .pickup-numbers-scrolly {
      display: block;
      margin-top: var(--space-5);
    }

    .pickup-numbers-scrolly__layout {
      display: grid;
      grid-template-columns: 1fr;
    }

    .pickup-numbers-scrolly__steps {
      grid-column: 1;
      grid-row: 1;
    }

    .pickup-numbers-scrolly__stage {
      grid-column: 1;
      grid-row: 1;
      position: sticky;
      top: 3rem;
      z-index: 1;
      box-sizing: border-box;
      height: calc(100dvh - 3rem);
      padding-block: var(--space-6);
      display: grid;
      grid-template-columns: minmax(0, 0.42fr) minmax(0, 0.58fr);
      gap: var(--space-5);
      align-items: center;
      pointer-events: none;
    }

    .pickup-numbers-scrolly[data-reduced] .pickup-numbers-scrolly__stage {
      position: relative;
      top: auto;
      height: auto;
      padding-block: 0;
    }

    .pickup-numbers-scrolly__step {
      min-height: 78vh;
    }

    .pickup-numbers-scrolly__step:first-child {
      min-height: 72vh;
    }

    .pickup-numbers-scrolly__step:last-child {
      min-height: 65vh;
    }

    .pickup-numbers-scrolly[data-reduced] .pickup-numbers-scrolly__step {
      min-height: auto;
    }

    .pickup-numbers-scrolly[data-reduced] .pickup-numbers-scrolly__step:first-child,
    .pickup-numbers-scrolly[data-reduced] .pickup-numbers-scrolly__step:last-child {
      min-height: auto;
    }

    .pickup-numbers-scrolly__copy {
      display: grid;
      gap: var(--space-3);
      align-content: center;
      min-height: 8rem;
    }

    .pickup-numbers-scrolly__line {
      margin: 0;
      max-width: 18ch;
      font-family: var(--font-home-display);
      font-size: clamp(1.85rem, 3.2vw, 3rem);
      font-weight: 400;
      letter-spacing: -0.025em;
      line-height: 1.12;
      color: color-mix(in srgb, var(--color-home-ink) 42%, transparent);
      text-wrap: balance;
      opacity: 0;
      max-height: 0;
      overflow: hidden;
      transition:
        opacity var(--dur-med) var(--ease-soft),
        max-height var(--dur-med) var(--ease-soft),
        color var(--dur-fast) var(--ease-soft);
    }

    .pickup-numbers-scrolly__line--sub {
      font-size: clamp(1.45rem, 2.4vw, 2.1rem);
    }

    .pickup-numbers-scrolly[data-active-step='1'] .pickup-numbers-scrolly__line[data-line='1'],
    .pickup-numbers-scrolly[data-active-step='2'] .pickup-numbers-scrolly__line[data-line='1'],
    .pickup-numbers-scrolly[data-active-step='2'] .pickup-numbers-scrolly__line[data-line='2'],
    .pickup-numbers-scrolly[data-active-step='3'] .pickup-numbers-scrolly__line[data-line='1'],
    .pickup-numbers-scrolly[data-active-step='3'] .pickup-numbers-scrolly__line[data-line='2'],
    .pickup-numbers-scrolly[data-active-step='3'] .pickup-numbers-scrolly__line[data-line='3'],
    .pickup-numbers-scrolly[data-active-step='4'] .pickup-numbers-scrolly__line[data-line='1'],
    .pickup-numbers-scrolly[data-active-step='4'] .pickup-numbers-scrolly__line[data-line='2'],
    .pickup-numbers-scrolly[data-active-step='4'] .pickup-numbers-scrolly__line[data-line='3'],
    .pickup-numbers-scrolly[data-active-step='4'] .pickup-numbers-scrolly__line[data-line='4'],
    .pickup-numbers-scrolly[data-active-step='4'] .pickup-numbers-scrolly__line[data-line='5'] {
      opacity: 1;
      max-height: 8rem;
    }

    .pickup-numbers-scrolly[data-active-step='2'] .pickup-numbers-scrolly__line[data-line='1'],
    .pickup-numbers-scrolly[data-active-step='3'] .pickup-numbers-scrolly__line[data-line='1'],
    .pickup-numbers-scrolly[data-active-step='3'] .pickup-numbers-scrolly__line[data-line='2'],
    .pickup-numbers-scrolly[data-active-step='4'] .pickup-numbers-scrolly__line[data-line='1'],
    .pickup-numbers-scrolly[data-active-step='4'] .pickup-numbers-scrolly__line[data-line='2'],
    .pickup-numbers-scrolly[data-active-step='4'] .pickup-numbers-scrolly__line[data-line='3'],
    .pickup-numbers-scrolly[data-active-step='4'] .pickup-numbers-scrolly__line[data-line='5'] {
      color: color-mix(in srgb, var(--color-home-ink) 48%, transparent);
    }

    .pickup-numbers-scrolly[data-active-step='1'] .pickup-numbers-scrolly__line[data-line='1'],
    .pickup-numbers-scrolly[data-active-step='2'] .pickup-numbers-scrolly__line[data-line='2'],
    .pickup-numbers-scrolly[data-active-step='3'] .pickup-numbers-scrolly__line[data-line='3'],
    .pickup-numbers-scrolly[data-active-step='4'] .pickup-numbers-scrolly__line[data-line='4'] {
      color: var(--color-home-ink);
    }

    .pickup-numbers-scrolly__emph {
      font-weight: 400;
      color: var(--color-home-ink);
    }

    .pickup-numbers-scrolly__grid-wrap {
      position: relative;
      width: min(100%, 22rem);
      justify-self: end;
    }

    .pickup-numbers-scrolly__band {
      position: absolute;
      left: -0.35rem;
      right: -0.35rem;
      bottom: 0;
      height: 20%;
      border-radius: 4px;
      background: var(--color-home-plate);
      border: 1px solid color-mix(in srgb, var(--color-home-ink) 12%, transparent);
      opacity: 0;
      transition: opacity var(--dur-med) var(--ease-soft);
      pointer-events: none;
      z-index: 0;
    }

    .pickup-numbers-scrolly[data-active-step='3'] .pickup-numbers-scrolly__band,
    .pickup-numbers-scrolly[data-active-step='4'] .pickup-numbers-scrolly__band {
      opacity: 1;
    }

    .pickup-numbers-scrolly__grid {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: repeat(10, 1fr);
      gap: clamp(4px, 0.65vw, 8px);
      aspect-ratio: 1;
    }

    .pickup-numbers-scrolly__dot {
      display: block;
      width: 100%;
      aspect-ratio: 1;
      border-radius: 50%;
      background: var(--color-home-rule);
      transition: background-color var(--dur-fast) var(--ease-soft);
    }

    .pickup-numbers-scrolly[data-active-step='2'] .pickup-numbers-scrolly__dot:nth-child(-n + 80),
    .pickup-numbers-scrolly[data-active-step='3'] .pickup-numbers-scrolly__dot:nth-child(-n + 80),
    .pickup-numbers-scrolly[data-active-step='4'] .pickup-numbers-scrolly__dot:nth-child(-n + 80) {
      background: var(--color-green);
    }

    .pickup-numbers-scrolly[data-active-step='4'] .pickup-numbers-scrolly__dot:nth-child(n + 81):nth-child(-n + 97) {
      background: var(--color-orange);
    }

    .pickup-numbers-scrolly[data-active-step='4'] .pickup-numbers-scrolly__dot:nth-child(n + 98) {
      background: var(--color-home-ink);
    }
  }

  @media print {
    .pickup-numbers-scrolly {
      display: none;
    }

    .pickup-numbers-scrolly__static {
      display: grid;
    }
  }
</style>
