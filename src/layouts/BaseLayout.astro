---
import { ClientRouter } from 'astro:transitions';
import Seo from '../components/Seo.astro';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname;
const isHome = path === '/';
const isProject = path.startsWith('/projects');
const quiet = isHome || isProject;

import bricolageWoff2 from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      (function () {
        function themeChoice() {
          try {
            var saved = localStorage.getItem('theme');
            if (saved === 'light' || saved === 'dark') return saved;
            if (window.matchMedia('(prefers-color-scheme: dark)').matches) return 'dark';
          } catch (e) {}
          return 'light';
        }

        function applyTheme(doc) {
          var root = (doc || document).documentElement;
          root.dataset.theme = themeChoice();
          try {
            var notch = localStorage.getItem('phone-notch');
            root.dataset.phoneNotch = notch === 'without' ? 'without' : 'with';
          } catch (e) {
            root.dataset.phoneNotch = 'with';
          }
        }

        applyTheme(document);
        if (!window.__themeReady) {
          window.__themeReady = true;
          document.addEventListener('astro:before-swap', function (event) {
            applyTheme(event.newDocument);
          });
        }
      })();
    </script>
    <Seo title={title} description={description} />
    {!quiet && (
      <link rel="preload" href={bricolageWoff2} as="font" type="font/woff2" crossorigin />
    )}
    <ClientRouter />
  </head>
  <body class:list={{ 'page-home': quiet }}>
    <a class="skip-link" href="#main">Skip to content</a>
    {
      !quiet && (
        <header class="site-header">
          <a class="site-header__mark" href="/" transition:name="brand">
            roshanashraf
          </a>
          <div class="site-header__right">
            <ThemeSwitch />
            <a class="site-header__navlink" href="/#work">← Work</a>
          </div>
        </header>
      )
    }
    <main id="main" class:list={{ 'home-shell': quiet, 'case-shell': isProject }}>
      <slot />
    </main>
    {
      !quiet && (
        <footer class="site-footer">
          <p>© {new Date().getFullYear()} roshanashraf</p>
          <p>Product design</p>
        </footer>
      )
    }
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-3);
    top: var(--space-3);
    transform: translateY(-200%);
    background: var(--color-ink);
    color: var(--color-on-ink);
    padding: 0.6rem 1rem;
    z-index: 100;
    border-radius: 100px;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
  }

  .skip-link:focus {
    transform: translateY(0);
  }
</style>
